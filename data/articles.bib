@thesis{Hao2019,
  type = {mathesis},
  title = {Music Genre Classification and Transfer Based on {{MusicXML}} with High-Level Features and Chord Vectors},
  author = {Hao, Yifei},
  date = {2019},
  institution = {{ResearchSpace@Auckland}},
  url = {https://researchspace.auckland.ac.nz/handle/2292/48913},
  urldate = {2023-03-09},
  abstract = {Music genres are labels grouped by musicians for categorizing and describing music pieces. Music genre classification is an important building block for digital music industry. In previous decades many works have been published on this field and they are mainly related to acoustic features, which results in a more physic-acoustic approach than high-level approach. Thus, genre classification from high-level perspective is needed since acoustic approach is more related to physics than music. There do exist some pieces of paper on high-level features, but they are all with relatively small database. In this paper, several high-level features are used to group music with different genres, which inputs are MusicXML files instead of recording excerpts. To make it happen, MusicXML files are selected to be the input database for feature calculation and a new database is built with 11,000 segments and 6 genres. Based on that, a system is developed to parse MusicXML files, extract its musical information for feature calculation, and random forest is performed as classifier. The proposed system proves its concept with results achieving the accuracy around 72.5\% in average for a three-category classification, and around 70.0\% for a four-category classification. To the best of my knowledge this is the first paper that using MusicXML file as input. On the other hand, music can be regarded as time series with each chord as a special word. Again using the MusicXML parser, system is able to handle music 'sentences' and train them into chord vectors using skip-gram model. Once this is done, TextCNN model is implemented on input sets using trained chord vectors for genre classification. For a three-category classification it approaches around 73.75\% success rate in average, and for a four-category classification it approaches around 71\% success rate. In conclusion, I believe that MusicXML files can play an important role on music data mining and its downstream tasks, since music professionals can contribute by raising additional features for classification, and it makes chord extraction and chord vector training possible. As more and more works done in image style transfer, there has been a rising trend in the effort of music genre transfer, which is a novel field with relatively few works. This thesis focuses on composition genre transfer, which means to alter a song's arrangements with its melody fixed. From trained chord vectors, a new method for style transfer is implemented. In addition, an end-to-end system is developed with MusicXML files from different genres. The system accepts an input melody and a certain genre name, and output a music score with input melody and chord sequences based on that genre. This system can be enhanced by adding more input with additional genres. From system outputs which are attached in appendix II, several genre features are found, showing that skip-gram model is able to learn relationships between chords among different genres. To the best of my knowledge, this is the first system for composition genre transfer. I believe that this system would contribute significantly for future music genre transfer research.},
  annotation = {Accepted: 2019-11-08T01:22:52Z}
}

@thesis{HaroBerois2013,
  type = {phdthesis},
  title = {Statistical Distribution of Common Audio Features : Encounters in a Heavy-Tailed Universe},
  shorttitle = {Statistical Distribution of Common Audio Features},
  author = {Haro Berois, Martín},
  date = {2013-11-22},
  journaltitle = {TDX (Tesis Doctorals en Xarxa)},
  institution = {{Universitat Pompeu Fabra}},
  issn = {2038-2014},
  url = {https://www.tdx.cat/handle/10803/128623},
  urldate = {2023-03-03},
  abstract = {In the last few years some Music Information Retrieval (MIR) researchers have spotted important drawbacks in applying standard successful-in-monophonic algorithms to polyphonic music classification and similarity assessment. Noticeably, these so called “Bag-of-Frames” (BoF) algorithms share a common set of assumptions. These assumptions are substantiated in the belief that the numerical descriptions extracted from short-time audio excerpts (or frames) are enough to capture relevant information for the task at hand, that these frame-based audio descriptors are time independent, and that descriptor frames are well described by Gaussian statistics. Thus, if we want to improve current BoF algorithms we could: i) improve current audio descriptors, ii) include temporal information within algorithms working with polyphonic music, and iii) study and characterize the real statistical properties of these frame-based audio descriptors. From a literature review, we have detected that many works focus on the first two improvements, but surprisingly, there is a lack of research in the third one. Therefore, in this thesis we analyze and characterize the statistical distribution of common audio descriptors of timbre, tonal and loudness information. Contrary to what is usually assumed, our work shows that the studied descriptors are heavy-tailed distributed and thus, they do not belong to a Gaussian universe. This new knowledge led us to propose new algorithms that show improvements over the BoF approach in current MIR tasks such as genre classification, instrument detection, and automatic tagging of music. Furthermore, we also address new MIR tasks such as measuring the temporal evolution of Western popular music. Finally, we highlight some promising paths for future audio-content MIR research that will inhabit a heavy-tailed universe.},
  langid = {english},
  keywords = {62,Audio classification,Audio features,Bag-of-frames,Content-based algorithms,Glass ceiling,Heavy-tailed distributions,Hubs,Music information retrieval,O-DONE,Power-law,Zipf},
  annotation = {Accepted: 2014-01-15T11:32:05Z},
  file = {/Users/owen/Zotero/storage/UTIUMJUS/Haro_Berois_2013.pdf}
}

@inproceedings{Hasan2021,
