}

@inproceedings{Zottesso2016,
  title = {Music Genre Classification Using Visual Features with Feature Selection},
  booktitle = {2016 35th {{International Conference}} of the {{Chilean Computer Science Society}} ({{SCCC}})},
  author = {Zottesso, Rafael H. D. and Costa, Yandre M. G. and Bertolini, Diego},
  date = {2016-10},
  pages = {1--6},
  doi = {10.1109/SCCC.2016.7836004},
  abstract = {This paper describes the results obtained in a set of experiments performed making feature selection using Genetic Algorithms. The objectives were to improve the recognition rates or to reduce the feature vector dimensionality in music genre recognition task. Firstly, music pieces taken from Latin Music Database were decomposed into 3 different sub-signals, each one with 10 seconds from beginning, middle and end parts of the original music. After binding these three parts, the 30 seconds music signals were converted into spectrograms. Considering a local feature extraction rather than a global one, a zoning mechanism is performed. In the experiments, we used the Local Binary Pattern texture descriptor in the feature extraction step, Genetic Algorithms for feature selection and Support Vector Machine to perform the classification. In short, obtained results have shown that it's possible to get an important dimensionality reduction in feature sets without great changes in recognition rates.},
  eventtitle = {2016 35th {{International Conference}} of the {{Chilean Computer Science Society}} ({{SCCC}})},
  keywords = {Databases,Feature extraction,feature selection,genetic algorithm,Genetic algorithms,Image segmentation,Music,Music genre recognition,O-DONE,Support vector machines,Visualization},
  file = {/Users/owen/Zotero/storage/LW7NB644/Zottesso_2016.pdf}
}

@online{Zuhair2021,
  title = {Comparing the Accuracy of Deep Neural Networks ({{DNN}}) and Convolutional Neural Network ({{CNN}}) in Music Genre Recognition ({{MGR}}): Experiments on Kurdish Music},
  shorttitle = {Comparing the Accuracy of Deep Neural Networks ({{DNN}}) and Convolutional Neural Network ({{CNN}}) in Music Genre Recognition ({{MGR}})},
  author = {Zuhair, Aza and Hassani, Hossein},
  date = {2021-11-22},
  eprint = {2111.11063},
  eprinttype = {arxiv},
  eprintclass = {cs, eess},
  doi = {10.48550/arXiv.2111.11063},
  url = {http://arxiv.org/abs/2111.11063},
  urldate = {2023-03-03},
  abstract = {Musicologists use various labels to classify similar music styles under a shared title. But, non-specialists may categorize music differently. That could be through finding patterns in harmony, instruments, and form of the music. People usually identify a music genre solely by listening, but now computers and Artificial Intelligence (AI) can automate this process. The work on applying AI in the classification of types of music has been growing recently, but there is no evidence of such research on the Kurdish music genres. In this research, we developed a dataset that contains 880 samples from eight different Kurdish music genres. We evaluated two machine learning approaches, a Deep Neural Network (DNN) and a Convolutional Neural Network (CNN), to recognize the genres. The results showed that the CNN model outperformed the DNN by achieving 92\% versus 90\% accuracy.},
  pubstate = {preprint},
  keywords = {Computer Science - Machine Learning,Computer Science - Sound,Electrical Engineering and Systems Science - Audio and Speech Processing,O-DONE},
  file = {/Users/owen/Zotero/storage/FYFYVYPT/Zuhair_2021.pdf}
}
