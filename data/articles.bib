  author = {Jang, Woo-Jin and Yun, Ho-Won and Shin, Seong-Hyeon and Cho, Hyo-Jin and Jang, Won and Park, Hochong},
  date = {2017},
  journaltitle = {Journal of Broadcast Engineering},
