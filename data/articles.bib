@online{Kim2023,
  title = {Integrated {{Parameter-Efficient Tuning}} for {{General-Purpose Audio Models}}},
  author = {Kim, Ju-ho and Heo, Jungwoo and Shin, Hyun-seo and Lim, Chan-yeong and Yu, Ha-Jin},
  date = {2023-03-01},
