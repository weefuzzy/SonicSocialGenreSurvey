  langid = {english},
  keywords = {album cover images,audio signal features,feature evaluation,lyrics,multi-modal classification,music genre recognition,O-DONE},
  file = {/Users/owen/Zotero/storage/GH3BQR9Y/Wilkes_2021.pdf}
}

