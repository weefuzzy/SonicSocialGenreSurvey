@article{Nakai2021,
  title = {Correspondence of Categorical and Feature-Based Representations of Music in the Human Brain},
  author = {Nakai, Tomoya and Koide-Majima, Naoko and Nishimoto, Shinji},
  date = {2021},
  journaltitle = {Brain and Behavior},
  volume = {11},
  number = {1},
